diff --git a/frappe/public/js/frappe/ui/island/loader.js b/frappe/public/js/frappe/ui/island/loader.js
new file mode 100644
index 0000000000..b351dbe4d8
--- /dev/null
+++ b/frappe/public/js/frappe/ui/island/loader.js
@@ -0,0 +1,129 @@
+/**
+ * frappe.ui.mount_island: the desk loader, the one call desk makes to put an
+ * app's island on a page.
+ *
+ *     const island = frappe.ui.mount_island("insights.dashboard", el, {
+ *         dashboard: "sales",
+ *         onTitle: (title) => frappe.utils.set_title(title || __("Dashboard")),
+ *     });
+ *     island.update({ filters });
+ *     island.unmount();
+ *
+ * The host loop in `@framework/ui/island/host` defines the props object, the
+ * handle and `ready`. This file is desk's half. It resolves a name against
+ * boot, assembles the desk context, and publishes the `frappe.ui` API.
+ *
+ * Resolution runs from the name to the registry in boot, then to assets.json,
+ * then to the module URL the host loop imports. An island is a self-contained
+ * ES module, so this file is part of desk's normal esbuild bundle, and the page
+ * needs nothing loaded ahead of the island.
+ *
+ * The caller passes the island's props. Desk adds `host` and `styles`. What the
+ * island does with them is the app's own build. See
+ * ui/island/decisions/0001-an-app-bundles-its-own-island.md.
+ */
+
+import {
+	mountIsland,
+	preloadIsland,
+	reloadChangedIslands,
+	unmountIsland,
+} from "@framework/ui/island/host";
+
+const ISLAND_JS_SUFFIX = ".island.js";
+const ISLAND_CSS_SUFFIX = ".island.css";
+
+/**
+ * @param {string} name        Island name, as the app's build registered it.
+ * @param {HTMLElement|JQuery} el
+ * @param {Object} [props]     Vue's props object: data and `on*` listeners.
+ * @returns {{ update: (props: Object) => void, unmount: () => void, ready: Promise }}
+ */
+function mount_island(name, el, props = {}) {
+	return mountIsland(name, el, {
+		resolve: resolve_island,
+		host: build_desk_context(),
+		props,
+	});
+}
+
+/** Starts downloading an island this site has, so a mount soon after finds it loaded. */
+export function preload_island(name) {
+	if (
+		frappe.boot?.ui_islands?.includes(name) &&
+		frappe.boot.assets_json?.[name + ISLAND_JS_SUFFIX]
+	) {
+		preloadIsland(resolve_island(name));
+	}
+}
+
+function resolve_island(name) {
+	const assets_json = frappe.boot?.assets_json || {};
+	// assets.json is bench-wide. The registry is the part of it this site has.
+	const js = frappe.boot?.ui_islands?.includes(name) && assets_json[name + ISLAND_JS_SUFFIX];
+	if (!js) {
+		throw new Error(
+			__('Island "{0}" is not on this site. Build the app that ships it.', [name])
+		);
+	}
+
+	return { js, css: assets_json[name + ISLAND_CSS_SUFFIX] || null };
+}
+
+/**
+ * The ambient context every island receives. The caller never assembles it, so an
+ * island honors desk's language and timezone with no per-island wiring. The mount
+ * contract adds `theme`, where it can be a tracked read.
+ *
+ * Everything here is data or a desk call. Nothing in it is a Vue value, because
+ * desk's bundle and the island run on separate copies of Vue.
+ */
+function build_desk_context() {
+	const boot = frappe.boot || {};
+	const context = {
+		locale: boot.lang || "en",
+		timezone: boot.time_zone?.user || boot.time_zone?.system || null,
+		user: frappe.session?.user || boot.user?.name || null,
+		base_url: frappe.urllib ? frappe.urllib.get_base_url() : window.location.origin,
+
+		// Desk routing, which an island cannot do for itself. The browser
+		// retargets a click inside a shadow root to the island's host element.
+		// Desk's anchor delegation then never matches, and a plain link reloads
+		// the page.
+		navigate: (route) => frappe.set_route(route),
+
+		// A value as desk prints a field of its type, as text. `doc` is what a fieldtype's
+		// `options` read, such as the field a Currency names for its currency.
+		format: (value, df, doc) =>
+			frappe.utils.html2text(frappe.format(value, df, { inline: true }, doc)),
+		format_axis_number,
+		developer_mode: Boolean(boot.developer_mode),
+		first_day_of_the_week: frappe.sys_defaults?.first_day_of_the_week || null,
+	};
+
+	return context;
+}
+
+/** An axis tick, shortened. A Currency axis keeps its symbol: "₹ 40 K". */
+function format_axis_number(value, df, doc) {
+	const shortened = frappe.utils.format_chart_axis_number(value);
+	if (df?.fieldtype !== "Currency") return shortened;
+
+	// as the number card prints a shortened amount
+	const [digits, unit] = shortened.split(" ");
+	const number = parseFloat(digits);
+	const decimals = frappe.utils.get_number_of_decimals(number);
+	const currency = frappe.meta.get_field_currency(df, doc);
+	return format_currency(number, currency, decimals) + (unit ? " " + unit : "");
+}
+
+frappe.provide("frappe.ui");
+frappe.ui.mount_island = mount_island;
+frappe.ui.unmount_island = unmountIsland;
+
+if (frappe.boot?.developer_mode) {
+	frappe.hot_update = frappe.hot_update || [];
+	// A rebuild moves the asset hash, so the islands on the page point at a stale
+	// module. Only the islands whose URL moved re-mount.
+	frappe.hot_update.push(() => reloadChangedIslands());
+}
